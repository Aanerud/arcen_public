[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Arcen%
DriverVer=08/09/2026,1.0.0.0
CatalogFile=arcen-iddcx.cat
PnpLockdown=1

[DestinationDirs]
DriverCopy=12,UMDF

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
arcen-iddcx.dll=1

[Manufacturer]
%Arcen%=ArcenModels,NTamd64.10.0...18362

[ArcenModels.NTamd64.10.0...18362]
%DeviceDescription%=ArcenIddCxInstall,ROOT\ARCENIDDCX

[ArcenIddCxInstall]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy
AddReg=ArcenIddCxDeviceGroup

[ArcenIddCxInstall.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=ArcenIddCxSecurity

[ArcenIddCxInstall.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[ArcenIddCxInstall.Wdf]
UmdfService=arcen-iddcx,ArcenIddCxService
UmdfServiceOrder=arcen-iddcx

[ArcenIddCxService]
UmdfLibraryVersion=2.33.0
ServiceBinary=%12%\UMDF\arcen-iddcx.dll
UmdfExtensions=IddCx0104

[ArcenIddCxDeviceGroup]
HKR,"WUDF","DeviceGroupId",0x00000000,"ArcenIddCx"

[ArcenIddCxSecurity]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;S-1-5-80-2794664030-2322002993-548807306-4095822587-2900116599)"

[DriverCopy]
arcen-iddcx.dll

[Strings]
Arcen="Arcen"
DiskName="Arcen IddCx installation media"
DeviceDescription="Arcen Dynamic Virtual Display Adapter"
