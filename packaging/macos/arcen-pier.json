{
  "listen": {
    "host": "0.0.0.0",
    "port": 18444
  },
  "tls": {
    "mode": "pem",
    "cert": "/Library/Application Support/Arcen/tls/host.crt",
    "key": "/Library/Application Support/Arcen/tls/host.key",
    "minimum_version": "TLS1.3",
    "disabled_cipher_suites": [],
    "expiry_warning_days": 30,
    "expected_sans": []
  },
  "capture": {},
  "video": {
    "bit_depth": "10",
    "color_range": "full",
    "color_matrix": "bt709",
    "color_policy": "default-off",
    "fps": 60,
    "encoder": "auto"
  },
  "audio": {
    "enabled": true,
    "compressed": true,
    "local_playback": "muted"
  },
  "microphone_input": {
    "enabled": true
  },
  "clipboard": {
    "direction": "both",
    "content": "all",
    "max_bytes": 8388608
  },
  "auth": {
    "disclaimer": {
      "enabled": false,
      "locale": "en_US",
      "directory": "/Library/Application Support/Arcen/disclaimers"
    },
    "reconnect_window_secs": 180
  },
  "redirection": {
    "timezone": true
  },
  "logging": {
    "level": 0,
    "retention_days": 30,
    "qos_targets": {
      "fps_degraded_percent": 90,
      "fps_critical_percent": 70,
      "rtt_degraded_ms": 60,
      "rtt_critical_ms": 150,
      "drop_degraded_basis_points": 50,
      "drop_critical_basis_points": 500,
      "input_degraded_ms": 50,
      "input_critical_ms": 120,
      "heartbeat_critical_misses": 3
    }
  },
  "platform": {
    "input_backend": "auto",
    "multi_monitor": {
      "advertise_enabled": true
    }
  }
}
