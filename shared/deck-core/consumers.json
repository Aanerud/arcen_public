    {
      "package": "arcen-deck-windows",
      "dependency_kind": "normal",
      "contracts": [
        "clipboard",
        "config",
        "connect_plan",
        "connection_draft",
        "decode",
        "decode_report",
        "directories",
        "display",
        "display_fit",
        "input",
        "log_target",
        "logging",
        "microphone",
        "multi_window",
        "network",
        "present",
        "reconnect",
        "reconnect_flow",
        "runtime",
        "screens",
        "services",
        "settings",
        "support_bundle"
      ],
      "features": [
        "egui",
        "runtime"
      ],
      "production_uses": [
        {
          "id": "fullscreen-bar-on-demand",
          "symbol": "render_connection_bar",
          "reason": "Fullscreen draws nothing over the video; the shared bar opens only at the top edge or with Ctrl+Alt+Home."
        },
        {
          "id": "fullscreen-bar-pointer-routing",
          "symbol": "route_pointer",
          "reason": "The session window lets the Deck's UI see the pointer at the top-edge strip and on the open bar through the shared routing rule."
        }
      ],
      "paths": [
        {
          "id": "windows-deck-platform",
          "entry_points": [
            "clients/windows/src/platform/mod.rs",
            "clients/windows/src/audio/mod.rs",
            "clients/windows/src/clipboard/mod.rs",
            "clients/windows/src/display/mod.rs",
            "clients/windows/src/logging/mod.rs",
            "clients/windows/src/platform/support.rs"
          ],
          "build_profiles": [
            "windows-deck"
          ],
          "validation": [
            "windows-deck-typecheck",
            "windows-deck-test",
            "windows-deck-session-lab"
          ],
          "owner": "Windows Client"
        },
        {
          "id": "windows-deck-session",
          "entry_points": [
            "clients/windows/src/lib.rs",
            "clients/windows/src/media.rs",
            "clients/windows/src/show.rs"
          ],
          "build_profiles": [
            "windows-deck"
          ],
          "validation": [
            "windows-deck-typecheck",
            "windows-deck-test",
            "windows-deck-session-lab"
          ],
          "owner": "Windows Client"
        },
