    "shared-deck-core-test",
    "shared-deck-core-clippy",
    "shared-deck-core-all-test",
    "shared-deck-core-all-clippy",
    "shared-deck-core-windows-typecheck",
    "shared-deck-core-tree-purity",
    "workspace-boundaries"
  ],
  "consumers": [
