{
  "schema_version": 1,
  "crate": "arcen-deck-core",
  "owner": "Shared/Architecture",
  "description": "The portable Deck: platform seams (DeckServices, VideoDecoderBackend, VideoPresenterSink), settings and, behind features, the session runtime and shared screens.",
