            "clients/windows/src/shell/launcher.rs",
            "clients/windows/src/shell/displays.rs",
            "clients/windows/src/shell/secondary.rs"
          ],
          "build_profiles": [
            "windows-deck"
          ],
          "validation": [
            "windows-deck-typecheck",
            "windows-deck-test",
            "windows-deck-session-lab"
          ],
          "owner": "Windows Client"
        }
      ]
    },
