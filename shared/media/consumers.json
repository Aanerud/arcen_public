      "production_uses": [
        {
          "id": "x11-desktop-depth",
          "gate": 1,
          "symbol": "serve_on_fixed_depth",
          "reason": "A persistent Xorg desktop's depth is chosen once by the shared rule, and a ten-bit request on an eight-bit desktop is served visibly as Auto, never as eight-bit samples in a ten-bit stream."
        },
        {
          "id": "desktop-plan",
          "gate": 1,
          "symbol": "resolve_desktop_plan",
          "reason": "A host that cannot report its desktop's encoding resolves sessions through the shared rule, so PQ is converted or refused, never relabelled."
        },
        {
          "id": "display-colour",
          "gate": 2,
          "symbol": "DisplayColor",
          "reason": "A client display's gamut and HDR luminance are interpreted by the shared rule on every host."
        },
        {
          "id": "video-queue",
          "gate": 3,
          "symbol": "SharedVideoQueue",
          "reason": "Drop, keyframe-recovery and IDR decisions come from the shared queue; hosts keep only wakeups."
        },
        {
          "id": "adaptive-rate-controller",
          "gate": 6,
          "symbol": "RateController",
          "reason": "Every Pier drives live bitrate changes through the shared transport-aware controller instead of a host-local rule."
        },
        {
          "id": "adaptive-rate-priority",
          "gate": 7,
          "symbol": "operational_rate_control_policy",
          "reason": "Every Pier applies the served pipeline's complete shared rate-control policy to adaptive bitrate control."
        },
        {
          "id": "local-video-backlog-signal",
          "gate": 6,
          "symbol": "take_wait_stats",
          "reason": "Linux and Windows feed the shared controller real host-side video queue wait instead of hiding QUIC/application backlog."
        }
