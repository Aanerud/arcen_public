      "contracts": ["install_lifecycle", "install_provider", "desktop_provider", "compositor_prefix", "wayland_qualification", "wayland_session"],
      "production_uses": [
        {
          "id": "install-transaction",
          "gate": 4,
          "symbol": "InstallTransaction",
          "reason": "Every installer's exit status comes from the shared transaction's finish(), so a Pier that is not running is never reported installed."
        },
        {
          "id": "install-provider-plan",
          "gate": 4,
          "symbol": "plan_install_provider",
          "reason": "The Linux installer chooses X11 or Wayland with the shared plan that mirrors the Pier's start-up selection, so an install never promises a desktop the Pier would refuse."
        }
      ],
      "paths": [
        {
          "id": "linux-installer",
          "entry_points": ["packaging/linux/installer/src/main.rs", "packaging/linux/installer/src/desktop.rs"],
