      ],
      "production_uses": [
        {
          "id": "session-lifecycle",
          "gate": 4,
          "symbol": "SessionLifecycles",
          "reason": "Each Pier reports its session steps to the shared lifecycle, which enforces ordering and readiness evidence the same way on every host."
        },
        {
          "id": "windows-agent-setup-budget",
          "gate": 4,
          "symbol": "SetupDeadline",
          "reason": "The broker's readiness wait and the agent's HDR activation wait come from one shared budget, so the agent refuses with a typed reason before the broker terminates it."
        },
        {
          "id": "agent-video-release",
          "gate": 6,
          "symbol": "VideoReleased",
          "reason": "The service tells its desktop agent which video frames its lane relay released, in the shared broker-agent vocabulary."
        },
        {
          "id": "windows-local-playback",
          "gate": 4,
          "symbol": "endpoint_report",
          "reason": "The Windows Pier proves its own speakers silent with the shared endpoint-mute evidence and admits the session through local_playback::admit, as every Pier does."
        },
        {
          "id": "windows-host-shutdown",
          "gate": 4,
          "symbol": "DrainDeadline",
          "reason": "When Windows shuts down or restarts, the service drains its sessions within the shared shutdown budget and the agent writes the session's one end record through the shared SessionTally, so both records land before Windows ends the processes."
        },
        {
          "id": "windows-hand-back",
          "gate": 4,
          "symbol": "DETACH_STEPS_OUTPUTS_FIRST",
          "reason": "A departing Deck's session is handed back in the shared order and locked per the shared Departure rule (ADR 0025, disconnect locks)."
        },
        {
          "id": "windows-held-lock",
          "gate": 4,
          "symbol": "HOLD_STEPS",
          "reason": "A session held for its Deck's resume is locked at once in the shared hold order, and a returning Deck that finds it locked is asked to sign in again (held_resume), since only the password unlocks it (GAP-044)."
        },
        {
          "id": "windows-lock-first-hand-back",
          "gate": 4,
          "symbol": "hand_back_order",
          "reason": "With privacy.desk required, or a session already locked, the hand-back locks before the desk gets its displays and input back, and a refused lock is asked again through the shared lock wait without giving the desk back (ADR 0025 §4)."
        },
        {
          "id": "windows-console-notice",
          "gate": 4,
          "symbol": "ConsoleNotice",
          "reason": "A refused bind tells the Deck the shared typed console refusal, naming another remote-desktop service as Windows reports it."
        }
      ],
