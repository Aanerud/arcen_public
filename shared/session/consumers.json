      "production_uses": [
        {
          "id": "session-lifecycle",
          "gate": 4,
          "symbol": "SessionLifecycles",
          "reason": "Each Pier reports its session steps to the shared lifecycle, which enforces ordering and readiness evidence the same way on every host."
        },
        {
          "id": "linux-login-session-beside-product",
          "gate": 4,
          "symbol": "LoginSessionProof",
          "reason": "Where another product runs the console's sign-in and withholds GDM's login screen, the Linux Pier starts the account's own login session only through the shared decision on the facts it proved (GDM answering, no X server, Arcen's login service, no product client) and a free seat0, so an unproved host keeps refusing and is never treated as one without a display manager."
        },
        {
          "id": "linux-guest-console-layout",
          "gate": 4,
          "symbol": "guest_layout_policy",
          "reason": "Whether another product's desktop takes the Deck's layout on attach is the shared decision from the console's owner, that product's client and platform.session.guest_layout, so the launcher never lays out a desktop whose client is attached or unknown."
        },
        {
          "id": "linux-guest-layout-departure",
          "gate": 4,
          "symbol": "LeaveDecks",
          "reason": "The Linux layout journal keeps the Deck's layout on another product's desktop through the shared LayoutDeparture, so the hand-back and the recovery never put back a layout under that product."
        },
        {
          "id": "linux-created-desktop-detach-lock",
          "gate": 4,
          "symbol": "DetachLock::on_detach",
          "reason": "Whether a desktop the Linux Pier created locks when its Deck leaves (kept, held for resume, handed over, ending, or without a lock screen) is the shared decision, so every departure that leaves it running locks it the same way."
        },
        {
          "id": "linux-session-handover",
          "gate": 4,
          "symbol": "SwitchLedger",
          "reason": "Every Linux console sign-in is decided by the shared ledger before the launcher runs, so the account's own desktop is always joined, another account is refused while a remote client is attached, and a confirmed, graceful sign-out of another account follows the same transaction and exit proof on every Pier."
        }
      ],
