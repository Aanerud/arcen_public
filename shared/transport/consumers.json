{
  "schema_version": 1,
  "crate": "arcen-transport",
  "owner": "Shared/Architecture",
  "description": "QUIC and TLS: certificate lifecycle, validation, pinning, priority audio, isolated QUIC lanes.",
  "validation": [
    "shared-transport-test",
    "shared-transport-clippy",
    "shared-transport-quic-test",
    "shared-transport-tree-purity",
    "workspace-boundaries"
  ],
  "consumers": [
    {
      "package": "arcen-deck-macos",
      "dependency_kind": "normal",
      "contracts": [
        "crate",
        "lanes",
        "quic",
        "quic::config",
        "quic::direct",
        "quic::feedback",
        "quic::lane_runtime",
        "quic::monitor",
        "quic::session_lanes",
        "tls"
      ],
      "features": ["quic"],
      "forwarded_features": {
        "wss-compat": [
          "wss-compat"
        ]
      },
      "paths": [
        {
          "id": "macos-deck-session",
          "entry_points": ["clients/macos/src/ui/app.rs"],
          "build_profiles": ["macos-deck-apple-silicon", "macos-deck-intel"],
          "validation": [
            "macos-deck-test-apple-silicon",
            "macos-deck-build-intel",
            "macos-deck-session-lab"
          ],
          "owner": "macOS Client"
        },
        {
          "id": "macos-deck-transport",
          "entry_points": [
            "clients/macos/src/transport/connector.rs",
            "clients/macos/src/transport/tls.rs",
            "clients/macos/src/transport/websocket.rs"
          ],
          "build_profiles": ["macos-deck-apple-silicon", "macos-deck-intel"],
          "validation": [
            "macos-deck-test-apple-silicon",
            "macos-deck-build-intel",
            "macos-deck-session-lab"
          ],
          "owner": "macOS Client"
        }
      ]
    },
    {
      "package": "arcen-pier-linux",
      "dependency_kind": "normal",
      "contracts": [
        "cert_marker",
        "cert_provisioning",
        "crate",
        "lanes",
        "path_signal",
        "quic",
        "quic::config",
        "quic::lane_runtime",
        "quic::session_lanes",
        "tls"
      ],
      "features": ["quic"],
      "forwarded_features": {
        "wss-compat": [
          "wss-compat"
        ]
      },
      "production_uses": [
        {
          "id": "lane-session",
          "gate": 3,
          "symbol": "accept_session_lanes",
          "reason": "Every role runs on the shared isolated lanes (ADR 0014); audio has its own lane and is never multiplexed onto video."
        },
        {
          "id": "lane-media-writer",
          "gate": 3,
          "symbol": "LocalLaneWriter",
          "reason": "Pier-opened video and audio lanes follow the shared lane recovery policy."
        },
        {
          "id": "interactive-send-window",
          "gate": 6,
          "symbol": "accept_session_lanes",
          "reason": "The shared lane carrier keeps every Deck connection's send window following its congestion window, so video cannot pile up inside QUIC ahead of audio and input."
        }
      ],
      "paths": [
        {
          "id": "linux-wayland-input",
          "entry_points": [
            "hosts/linux/src/net/lane_workers.rs"
          ],
          "build_profiles": ["linux-pier-wayland-provider"],
          "validation": ["linux-pier-wayland-provider-test", "linux-wayland-input-lab"],
          "owner": "Linux Host"
        },
        {
          "id": "linux-xorg-hdr",
          "entry_points": ["hosts/linux/src/cli.rs"],
          "build_profiles": ["linux-pier"],
          "validation": ["linux-pier-test", "linux-xorg-hdr-lab"],
          "owner": "Linux Host"
        },
        {
          "id": "linux-session",
          "entry_points": ["hosts/linux/src/cli.rs"],
          "build_profiles": ["linux-pier"],
          "validation": ["linux-pier-test", "linux-session-lab"],
          "owner": "Linux Host"
        },
        {
          "id": "linux-transport",
          "entry_points": [
            "hosts/linux/src/net/quic.rs",
            "hosts/linux/src/net/server.rs",
            "hosts/linux/src/net/tls.rs"
          ],
          "build_profiles": ["linux-pier"],
          "validation": ["linux-pier-test", "linux-session-lab"],
          "owner": "Linux Host"
        }
      ]
    },
    {
      "package": "arcen-pier-linux-installer",
      "dependency_kind": "normal",
      "contracts": ["cert_marker", "cert_provisioning", "cert_transaction"],
      "paths": [
        {
          "id": "linux-installer",
          "entry_points": ["packaging/linux/installer/src/main.rs"],
          "build_profiles": ["linux-pier-installer"],
          "validation": ["linux-pier-installer-build"],
          "owner": "Linux Host"
        }
      ]
    },
    {
      "package": "arcen-pier-macos",
      "dependency_kind": "normal",
      "contracts": [
        "cert_marker",
        "cert_provisioning",
        "cert_transaction",
        "crate",
        "path_signal",
        "quic",
        "quic::config",
        "quic::direct",
        "quic::lane_relay",
        "quic::lane_runtime",
        "quic::session_lanes"
      ],
      "features": ["quic"],
      "production_uses": [
        {
          "id": "lane-session",
          "gate": 3,
          "symbol": "accept_session_lanes",
          "reason": "Every role runs on the shared isolated lanes (ADR 0014); the daemon and serve accept only the lane carrier."
        },
        {
          "id": "lane-relay",
          "gate": 3,
          "symbol": "PierLaneRelay",
          "reason": "The session behind the local socket reaches the Deck through the shared relay: one lane per role, no role falls back onto another."
        },
        {
          "id": "interactive-send-window",
          "gate": 6,
          "symbol": "accept_session_lanes",
          "reason": "The shared lane carrier keeps every Deck connection's send window following its congestion window, so video cannot pile up inside QUIC ahead of audio and input."
        }
      ],
      "paths": [
        {
          "id": "macos-pier-auto",
          "entry_points": ["hosts/macos/src/stream.rs", "hosts/macos/src/session.rs"],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-auto-lab"],
          "owner": "macOS Host"
        },
        {
          "id": "macos-pier-speed",
          "entry_points": ["hosts/macos/src/stream.rs", "hosts/macos/src/session.rs"],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-speed-lab"],
          "owner": "macOS Host"
        },
        {
          "id": "macos-pier-grading",
          "entry_points": ["hosts/macos/src/session.rs"],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-grading-lab"],
          "owner": "macOS Host"
        },
        {
          "id": "macos-pier-audio",
          "entry_points": ["hosts/macos/src/stream.rs", "hosts/macos/src/relay.rs"],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-av-input-lab"],
          "owner": "macOS Host"
        },
        {
          "id": "macos-pier-session",
          "entry_points": ["hosts/macos/src/session.rs", "hosts/macos/src/main.rs"],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-app-build", "macos-pier-session-lab"],
          "owner": "macOS Host"
        },
        {
          "id": "macos-pier-transport",
          "entry_points": [
            "hosts/macos/src/net.rs",
            "hosts/macos/src/relay.rs",
            "hosts/macos/src/main.rs"
          ],
          "build_profiles": ["macos-pier"],
          "validation": ["macos-pier-test", "macos-pier-session-lab"],
          "owner": "macOS Host"
        }
      ]
    },
    {
      "package": "arcen-pier-windows",
      "dependency_kind": "normal",
      "contracts": [
        "crate",
        "path_signal",
        "quic",
        "quic::config",
        "quic::direct",
        "quic::lane_relay",
        "quic::lane_runtime",
        "quic::session_lanes",
        "tls"
      ],
      "features": ["quic"],
      "forwarded_features": {
        "wss-compat": [
          "wss-compat"
        ]
      },
      "production_uses": [
        {
          "id": "lane-session",
          "gate": 3,
          "symbol": "accept_session_lanes",
          "reason": "Every role runs on the shared isolated lanes (ADR 0014); the broker accepts only the lane carrier."
        },
        {
          "id": "lane-relay",
          "gate": 3,
          "symbol": "PierLaneRelay",
          "reason": "The agent's session reaches the Deck through the shared relay: one lane per role, no role falls back onto another."
        },
        {
          "id": "interactive-send-window",
          "gate": 6,
          "symbol": "accept_session_lanes",
          "reason": "The shared lane carrier keeps every Deck connection's send window following its congestion window, so video cannot pile up inside QUIC ahead of audio and input."
        }
      ],
      "paths": [
        {
          "id": "windows-grading",
          "entry_points": ["hosts/windows/src/session.rs"],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test", "windows-grading-lab"],
          "owner": "Windows Host"
        },
        {
          "id": "windows-hdr",
          "entry_points": ["hosts/windows/src/session.rs"],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test", "windows-hdr-lab"],
          "owner": "Windows Host"
        },
        {
          "id": "windows-audio",
          "entry_points": ["hosts/windows/src/resume.rs"],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test", "windows-av-input-lab"],
          "owner": "Windows Host"
        },
        {
          "id": "windows-session",
          "entry_points": [
            "hosts/windows/src/session.rs",
            "hosts/windows/src/resume.rs",
            "hosts/windows/src/main.rs"
          ],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test", "windows-session-lab"],
          "owner": "Windows Host"
        },
        {
          "id": "windows-transport",
          "entry_points": [
            "hosts/windows/src/quic.rs",
            "hosts/windows/src/tls.rs",
            "hosts/windows/src/main.rs"
          ],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test", "windows-session-lab"],
          "owner": "Windows Host"
        },
        {
          "id": "windows-multi-monitor",
          "entry_points": ["hosts/windows/src/main.rs"],
          "build_profiles": ["windows-pier"],
          "validation": ["windows-pier-test"],
          "owner": "Windows Host"
        }
      ]
    },
    {
      "package": "arcen-pier-windows-installer",
      "dependency_kind": "normal",
      "contracts": ["cert_marker", "cert_provisioning"],
      "paths": [
        {
          "id": "windows-installer",
          "entry_points": ["packaging/windows/installer/src/main.rs"],
          "build_profiles": ["windows-pier-installer"],
          "validation": ["windows-pier-installer-build"],
          "owner": "Windows Host"
        }
      ]
    },
    {
      "package": "arcen-pier-linux-installer",
      "dependency_kind": "embedded",
      "contracts": ["crate"],
      "via": ["arcen-pier-linux"],
      "paths": [
        {
          "id": "linux-installer",
          "entry_points": [
            "packaging/linux/installer/src/main.rs",
            "packaging/linux/installer/build.rs"
          ],
          "build_profiles": ["linux-pier-installer"],
          "validation": ["linux-pier-installer-build"],
          "owner": "Linux Host"
        }
      ]
    },
    {
      "package": "arcen-pier-windows-installer",
      "dependency_kind": "embedded",
      "contracts": ["crate"],
      "via": ["arcen-pier-windows"],
      "paths": [
        {
          "id": "windows-installer",
          "entry_points": [
            "packaging/windows/installer/src/main.rs",
            "packaging/windows/installer/build.rs"
          ],
          "build_profiles": ["windows-pier-installer"],
          "validation": ["windows-pier-installer-build"],
          "owner": "Windows Host"
        }
      ]
    }
  ]
}
