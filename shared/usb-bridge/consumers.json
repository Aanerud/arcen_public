{
  "schema_version": 1,
  "crate": "arcen-usb-bridge",
  "owner": "Shared/Architecture",
  "description": "USB passthrough policy and state.",
  "validation": ["shared-usb-bridge-test", "shared-usb-bridge-clippy", "workspace-boundaries"],
  "consumers": [
    {
      "package": "arcen-deck-macos",
      "dependency_kind": "normal",
      "contracts": [
